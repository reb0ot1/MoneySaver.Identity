<configuration>
    <packageSources>
        <clear />
        <add key="github" value="https://nuget.pkg.github.com/reb0ot1/index.json" />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>
    <!-- Configure GitHub package credentials outside the repository.
         Use local machine NuGet config or CI secrets for the github source. -->
</configuration>
