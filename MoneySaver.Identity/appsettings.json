{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.MariaDB" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "MariaDB",
        "Args": {
          "connectionString": "server=host.docker.internal;Port=1000;uid=root;pwd=SecretPass;database=db_logging",
          "autoCreateTable": true,
          "tableName": "logging_identity",
          "batchPostingLimit": 1000,
          "storeTimestampInUtc": true,
          "options": {
            "PropertiesToColumnsMapping": {
              "Exception": "Exception",
              "Level": "Level",
              "Message": "Message",
              "MessageTemplate": "MessageTemplate",
              "Timestamp": "Timestamp",
              "ActionId": "ActionId",
              "Application": "Application",
              "SourceContext": "SourceContext"
            },
            "TimestampInUtc": true,
            "ExcludePropertiesWithDedicatedColumn": false,
            "EnumsAsInts": true,
            "LogRecordsCleanupFrequency": "0.02:00:00",
            "LogRecordsExpiration": "31.00:00:00"
          }
        }
      }
    ],
    "Properties": {
      "Application": "MoneySaver Identity"
    }
  },
  "UrlRoutesConfiguration": {
    "DataApiUrl": ""
  },
  "ApplicationSettings": {
    "Secret": "S0M3 M4G1C UN1C0RNS G3N3R4T3D TH1S S3CR3T"
  }
}
